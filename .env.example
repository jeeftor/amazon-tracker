# Both published ports are bound to 127.0.0.1 in compose.yml.
PANEL_PORT=8080
NOVNC_PORT=6080
# Your interactive session expires after 15 minutes; reopen it to continue.
INTERACTIVE_TIMEOUT_SECONDS=900
# Keep enabled unless your container platform cannot run the Chromium sandbox.
CHROMIUM_SANDBOX=true
# Maximum recent-order pages in a manual discovery scan (1–10).
DISCOVERY_MAX_PAGES=5

# Optional notification overrides. Leave commented to configure through your panel.
# Explicit values here lock that field in the UI, including false or an empty value.
# MQTT_ENABLED=false
# MQTT_HOST=host.docker.internal
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_BASE_TOPIC=amazon/tracker
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
